+/// The window's restore geometry and display state, for Client State.
+///
+/// `window_bounds()` carries the restore bounds while a window is maximized
+/// or fullscreen; `bounds()` is what is on screen now, which is what a plain
+/// windowed window should remember.
+#[cfg(any(
+    target_os = "macos",
+    target_os = "windows",
+    target_os = "linux",
+    target_os = "freebsd"
+))]
+fn window_placement(window: &gpui::Window, cx: &gpui::App) -> WindowPlacement {
+    #[cfg(not(target_os = "windows"))]
+    let live = window.bounds();
+    let (restore, bounds_maximized, bounds_fullscreen) = match window.window_bounds() {
+        gpui::WindowBounds::Windowed(bounds) => (bounds, false, false),
+        gpui::WindowBounds::Maximized(bounds) => (bounds, true, false),
+        gpui::WindowBounds::Fullscreen(bounds) => (bounds, false, true),
+    };
+    // macOS reports a zoomed window as `Windowed`; `is_maximized` is the only
+    // signal there, and on Windows it also catches Win+Up snaps.
+    let maximized = bounds_maximized || window.is_maximized();
+    let fullscreen = bounds_fullscreen || window.is_fullscreen();
+    // On Windows `window_bounds().Windowed` is computed with the same
+    // client-rect math the create path consumes, so it round-trips exactly.
+    // Saving `window.bounds()` (the real client rect) instead walked the
+    // window down by the title-bar asymmetry on every relaunch: gpui splits
+    // the non-client height evenly top/bottom, while the real top is the
+    // whole title bar.
+    #[cfg(target_os = "windows")]
+    let bounds = restore;
+    #[cfg(not(target_os = "windows"))]
+    let bounds = if maximized || fullscreen { restore } else { live };
+    WindowPlacement {
+        x: f32::from(bounds.origin.x) as f64,
+        y: f32::from(bounds.origin.y) as f64,
+        width: f32::from(bounds.size.width) as f64,
+        height: f32::from(bounds.size.height) as f64,
+        maximized,
+        fullscreen,
+        display: window.display(cx).map(|display| {
+            let display_bounds = display.bounds();
+            WindowPlacementDisplay {
+                uuid: display.uuid().ok().map(|uuid| uuid.to_string()),
+                bounds: DisplayBounds {
+                    x: f32::from(display_bounds.origin.x) as f64,
+                    y: f32::from(display_bounds.origin.y) as f64,
+                    width: f32::from(display_bounds.size.width) as f64,
+                    height: f32::from(display_bounds.size.height) as f64,
+                },
+            }
+        }),
+    }
+}
+
+/// The display a remembered window belonged to, by uuid first and by the
+/// display containing the window centre second.
+#[cfg(any(
+    target_os = "macos",
+    target_os = "windows",
+    target_os = "linux",
+    target_os = "freebsd"
+))]
+fn remembered_display_id(
+    options: &WindowOptions,
+    x: f64,
+    y: f64,
+    width: f32,
+    height: f32,
+    cx: &gpui::App,
+) -> Option<gpui::DisplayId> {
+    let displays = cx.displays();
+    if let Some(uuid) = options
+        .display
+        .as_ref()
+        .and_then(|display| display.uuid.as_deref())
+    {
+        if let Some(found) = displays.iter().find(|candidate| {
+            candidate
+                .uuid()
+                .map(|uuid| uuid.to_string())
+                .ok()
+                .as_deref()
+                == Some(uuid)
+        }) {
+            return Some(found.id());
+        }
+    }
+    let centre = gpui::point(
+        gpui::px(x as f32 + width / 2.0),
+        gpui::px(y as f32 + height / 2.0),
+    );
+    displays
+        .into_iter()
+        .find(|candidate| candidate.bounds().contains(&centre))
+        .map(|display| display.id())
+}
+
+/// The window bounds and display to open with.
+///
+/// A remembered `x`/`y` is only used when its display can still be found;
+/// otherwise (no `x`/`y`, or a display that is gone) the window opens centred
+/// on the primary display, exactly as before placement was remembered.
+#[cfg(any(
+    target_os = "macos",
+    target_os = "windows",
+    target_os = "linux",
+    target_os = "freebsd"
+))]
+fn resolve_window_bounds(
+    options: &WindowOptions,
+    cx: &gpui::App,
+) -> (gpui::Bounds<gpui::Pixels>, Option<gpui::DisplayId>) {
+    let width = options.width.unwrap_or(800.0) as f32;
+    let height = options.height.unwrap_or(600.0) as f32;
+    let size = gpui::size(gpui::px(width), gpui::px(height));
+    if let (Some(x), Some(y)) = (options.x, options.y) {
+        if let Some(display_id) = remembered_display_id(options, x, y, width, height, cx) {
+            return (
+                gpui::Bounds::new(gpui::point(gpui::px(x as f32), gpui::px(y as f32)), size),
+                Some(display_id),
+            );
+        }
+    }
+    (gpui::Bounds::centered(None, size, cx), None)
+}
